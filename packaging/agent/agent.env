# NextPane agent configuration. Root-only: it contains the enrollment token.
# After editing: systemctl restart nextpane-agent

# WebSocket URL of the panel, e.g. wss://panel.example.com/agent/ws or wss://203.0.113.10:3000/agent/ws
NEXTPANE_SERVER=

# Only for a panel with a self-signed certificate: its sha256 fingerprint (shown in the panel).
# The agent then trusts exactly that certificate instead of a certificate authority.
#NEXTPANE_FINGERPRINT=

# Enrollment key (Hosts > Add host). Only used for the first connection; the agent then
# authenticates with a per-host secret stored in /var/lib/nextpane-agent/host.secret.
NEXTPANE_TOKEN=

# Force a firewall backend instead of auto-detection: ufw | firewalld | nftables | iptables | none
#NEXTPANE_FIREWALL=

# PATH for builds and apps, e.g. to use Node.js from /opt/node/bin
#NEXTPANE_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
