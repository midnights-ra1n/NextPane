# NextPane server configuration. After editing: systemctl restart nextpane-server

# Address and port to listen on. Put a TLS reverse proxy (Caddy, nginx...) in front of it.
NEXTPANE_LISTEN=0.0.0.0:3000

# Database, secret key (encrypts env vars, back it up!) and update downloads.
NEXTPANE_DATA=/var/lib/nextpane-server

# Where releases are published, e.g. https://github.com/midnights-ra1n/NextPane/releases
# Enables one-click updates of the server and the agents, and /install.sh. Empty = disabled.
NEXTPANE_RELEASE_URL=

# Seconds between agent metric reports, and between git checks of auto-deployed apps.
#NEXTPANE_METRICS_INTERVAL=10
#NEXTPANE_POLL_INTERVAL=60
