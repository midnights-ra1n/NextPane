# Managed by Ansible (role nextpane_agent).
NEXTPANE_SERVER={{ nextpane_server_url }}
NEXTPANE_TOKEN={{ nextpane_enroll_token }}
{% if nextpane_server_fingerprint %}
NEXTPANE_FINGERPRINT={{ nextpane_server_fingerprint }}
{% endif %}
{% if nextpane_firewall %}
NEXTPANE_FIREWALL={{ nextpane_firewall }}
{% endif %}
{% if nextpane_path %}
NEXTPANE_PATH={{ nextpane_path }}
{% endif %}
